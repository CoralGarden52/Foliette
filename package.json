{
  "name": "foliette",
  "version": "1.0.0",
  "private": true,
  "description": "Foliette · 手帐风照片墙 —— 拖拽排版、贴纸、文字、一键导出",
  "scripts": {
    "start:oss": "node --env-file=.env.oss server/src/index.js",
    "oss:check": "node --env-file-if-exists=.env.oss server/src/oss-check.js",
    "oss:migrate": "node --env-file-if-exists=.env.oss server/src/oss-migrate.js",
    "admin:user": "node scripts/admin-user.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm --prefix server run dev",
    "dev:web": "npm --prefix web run dev",
    "setup": "npm --prefix server ci && npm --prefix web ci",
    "check": "npm --prefix web run check",
    "build": "npm --prefix web run build",
    "start": "npm --prefix server start",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
