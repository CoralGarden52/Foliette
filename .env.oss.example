# 本地 OSS 联调配置：复制为 .env.oss，填写 RAM 用户凭证后执行 npm run oss:check
PHOTO_STORAGE=oss
OSS_BUCKET=foliette-photos-prod
OSS_REGION=oss-cn-shenzhen
OSS_ENDPOINT=https://oss-cn-shenzhen.aliyuncs.com
OSS_CNAME=0
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# RAM 永久 AccessKey 留空；只有使用 STS 临时凭证时才填写。
OSS_SECURITY_TOKEN=
PORT=8787
ADMIN_USER_IDS=
