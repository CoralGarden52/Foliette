# ---- Foliette 环境变量示例（复制为 .env 后按需修改）----
NODE_ENV=production
PORT=8080
# 生产环境务必修改为一个足够长的随机字符串
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=30d
# 数据目录（SQLite 数据库 + 用户上传的照片）
DATA_DIR=./server/data
# 素材目录（头像 / 贴纸）
ASSETS_DIR=./assets
# 单张照片墙最多照片数
MAX_PHOTOS_PER_WALL=20
# 单个上传文件大小上限（字节）
MAX_UPLOAD_BYTES=12582912
COOKIE_SECURE=0
TRUST_PROXY=0
# 允许查看 /admin/stats 的已注册用户 ID，多个用英文逗号分隔。留空则无人有权限。
# 查询：npm run admin:user -- 已注册的邮箱（使用实际 DATA_DIR）
ADMIN_USER_IDS=
# 照片存储：local 保持本地；oss 使用下方 Bucket。先配置凭证再切换。
PHOTO_STORAGE=local
OSS_BUCKET=foliette-photos-prod
OSS_REGION=oss-cn-shenzhen
OSS_ENDPOINT=https://oss-cn-shenzhen.aliyuncs.com
OSS_CNAME=0
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_SECURITY_TOKEN=
